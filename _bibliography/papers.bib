@inproceedings{afroz2026narrative,
  title     = {Fine-grained Narrative Classification in Biased News Articles},
  author    = {Afroz, Zeba and Vardhan, Harsh and Bhakuni, Pawan and Punia, Aanchal and Kumar, Rajdeep and Akhtar, Md. Shad},
  booktitle = {Proceedings of the Joint International Conference on Computational Linguistics, Language Resources and Evaluation (LREC)},
  year      = {2026},
  abbr      = {LREC},
  arxiv     = {2512.03582},
  pdf       = {https://arxiv.org/pdf/2512.03582},
  abstract  = {We propose a fine-grained narrative classification framework for biased news articles, with article-bias classification as a precursor task alongside fine-grained persuasive technique identification. We introduce INDI-PROP, the first ideologically grounded fine-grained narrative dataset with multi-level annotation for propaganda in Indian news, covering 1,266 articles across two polarizing socio-political events (CAA and the Farmers' protest), annotated at three hierarchical levels.},
  bibtex_show = {true},
  selected  = {true}
}

@article{nair2025incongruence,
  title     = {Incongruence Identification in Eyewitness Testimony},
  author    = {Nair, Akshara and Afroz, Zeba and Akhtar, Md. Shad},
  journal   = {arXiv preprint arXiv:2502.05650},
  year      = {2025},
  abbr      = {arXiv},
  arxiv     = {2502.05650},
  pdf       = {https://arxiv.org/pdf/2502.05650},
  abstract  = {We introduce the task of detecting incongruences between eyewitness testimonies. Given Q\&A exchange pairs from two subjects, the system identifies contextually related inconsistencies and marks their spans. We introduce MIND (MultI-EyewitNess Deception), a dataset of 2,927 contextually related answer pairs, and the INTEND framework, grounded in investigative 6W and multi-hop reasoning.},
  bibtex_show = {true},
  selected  = {true}
}
